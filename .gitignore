# Secrets: never commit. Each package has a .env.example listing the names.
.env
.env.*
!.env.example
*.local

# Dependencies and caches
node_modules/
.cache/
.astro/

# Build output
web/dist/
cms/dist/
cms/build/
cms/.strapi/
cms/.tmp/
cms/public/uploads/*
!cms/public/uploads/.gitkeep

# Seed media staging (re-encoded copies of allow-listed files; regenerated by the seed)
cms/.seed-media/

# Test and audit output (Lighthouse reports, Playwright traces)
web/test-results/
web/playwright-report/
reports/

# Previews and renders never go in git (user policy)
previews/

.DS_Store
*.log

# Media synced into the web build by scripts/fetch-content.ts (source: cms/seed/media or Strapi)
web/src/assets/cms/
web/public/media/
web/public/og/

# GLB exporter scratch (staged copy of mod generators, raw Blender output)
tools/export-glb/.work/

# self-hosted viewer runtime copied from node_modules by scripts/vendor.ts
web/public/vendor/

# logo family installed from brand/ by web/scripts/brand.ts
web/public/brand/
web/public/favicon.svg
web/public/favicon.ico
web/public/favicon-32.png
web/public/apple-touch-icon.png
web/public/icon-*.png

# draft-preview Worker build output
web/dist-preview/
web/.wrangler/
web/.dev.vars

# Block-explorer GLBs: not in git. tools/export-glb exports them locally; pack.mjs makes a GitHub Release tarball that
# web/scripts/fetch-models.ts downloads at build time (the catalogue + .release.json in web/src/data/models are tracked).
web/public/models/*/

# Private lists and private seed entries: never committed (the repo is public). CI writes the lists from the
# PRIVACY_LOCAL_JSON secret. `cd cms && npm run check:public` fails if their terms reach a tracked file.
cms/config/privacy.local.json
cms/seed/private.ts
cms/seed/private.json
