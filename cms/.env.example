# Copy to .env and fill in. Never commit .env.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HOST=127.0.0.1
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
STRAPI_TELEMETRY_DISABLED=true
# Strapi's MCP server at /mcp (admin tokens only).
MCP_ENABLED=false

# Local dev database (SQLite). Strapi Cloud provides its own database env vars.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Draft preview (ARCHITECTURE §6). Local: the Astro dev server.
PREVIEW_URL=http://localhost:4321
PREVIEW_SECRET=tobemodified-32-random-bytes

# Site rebuild trigger (src/rebuild-trigger.ts): on publish/unpublish/delete, ask GitHub Actions to rebuild the site
# (repository_dispatch "cms-content-changed" -> .github/workflows/pages.yml). Leave empty locally: the trigger is off.
# Strapi Cloud: GITHUB_REPO=riokulabs/riokulabs-site and a fine-grained PAT for that repo with Contents: read and write.
GITHUB_REPO=
GITHUB_DISPATCH_TOKEN=
# Optional: quiet period before the dispatch, in ms (default 60000; bursts collapse into one rebuild).
REBUILD_DEBOUNCE_MS=
