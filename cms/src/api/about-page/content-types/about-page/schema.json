{
  "kind": "singleType",
  "collectionName": "about_pages",
  "info": {
    "singularName": "about-page",
    "pluralName": "about-pages",
    "displayName": "About page",
    "description": "The About page: title, intro and body."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "intro": {
      "type": "text"
    },
    "body": {
      "type": "dynamiczone",
      "components": [
        "sections.rich-text",
        "sections.image",
        "sections.gallery",
        "sections.loop-video",
        "sections.youtube-embed",
        "sections.compare",
        "sections.code",
        "sections.callout",
        "sections.quote",
        "sections.model-embed",
        "sections.mod-card",
        "sections.timeline-embed",
        "sections.stat-grid"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "pressTitle": {
      "type": "string",
      "maxLength": 60
    },
    "pressText": {
      "type": "text",
      "maxLength": 300
    }
  }
}
