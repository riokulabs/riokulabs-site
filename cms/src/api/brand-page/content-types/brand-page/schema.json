{
  "kind": "singleType",
  "collectionName": "brand_pages",
  "info": {
    "singularName": "brand-page",
    "pluralName": "brand-pages",
    "displayName": "Brand page",
    "description": "The Brand page: body text, logo downloads and boilerplate copy."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "body": {
      "type": "dynamiczone",
      "components": [
        "sections.rich-text",
        "sections.image",
        "sections.gallery",
        "sections.loop-video",
        "sections.compare",
        "sections.code",
        "sections.callout",
        "sections.quote",
        "sections.model-embed",
        "sections.mod-card",
        "sections.timeline-embed",
        "sections.stat-grid"
      ]
    },
    "downloads": {
      "type": "component",
      "repeatable": true,
      "component": "shared.download"
    },
    "boilerplateShort": {
      "type": "text"
    },
    "boilerplateLong": {
      "type": "text"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
