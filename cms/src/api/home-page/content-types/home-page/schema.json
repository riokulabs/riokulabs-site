{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Home page",
    "description": "The home page: hero, calls to action, featured mod and principles."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "heroTagline": {
      "type": "string",
      "required": true
    },
    "heroSubline": {
      "type": "text"
    },
    "heroMedia": {
      "type": "component",
      "repeatable": false,
      "component": "media.visual"
    },
    "ctaPrimary": {
      "type": "component",
      "repeatable": false,
      "component": "shared.link"
    },
    "ctaSecondary": {
      "type": "component",
      "repeatable": false,
      "component": "shared.link"
    },
    "featuredMod": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::mod.mod"
    },
    "historyFamily": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::timeline-family.timeline-family"
    },
    "principles": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.feature"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "modsHeading": {
      "type": "string",
      "maxLength": 60
    },
    "postsHeading": {
      "type": "string",
      "maxLength": 60
    },
    "teaserTitle": {
      "type": "string",
      "maxLength": 60
    },
    "teaserText": {
      "type": "string",
      "maxLength": 160
    },
    "teaserStatus": {
      "type": "string",
      "maxLength": 30
    },
    "hudLabel": {
      "type": "string",
      "maxLength": 40
    },
    "hudHint": {
      "type": "string",
      "maxLength": 40
    }
  }
}
