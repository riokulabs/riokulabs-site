{
  "kind": "singleType",
  "collectionName": "site_settings_list",
  "info": {
    "singularName": "site-settings",
    "pluralName": "site-settings-list",
    "displayName": "Site settings",
    "description": "Site-wide name, default SEO, logos, social links, the not-affiliated notice, footer and page-title wording, and the text of the listing pages."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true,
      "default": "Rioku Labs"
    },
    "shortName": {
      "type": "string",
      "default": "Rioku Labs"
    },
    "description": {
      "type": "text"
    },
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "logo": {
      "type": "component",
      "repeatable": false,
      "component": "media.image"
    },
    "logoMark": {
      "type": "component",
      "repeatable": false,
      "component": "media.image"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link"
    },
    "notAffiliatedText": {
      "type": "text"
    },
    "analyticsEnabled": {
      "type": "boolean",
      "default": false
    },
    "footerPitch": {
      "type": "text",
      "maxLength": 200
    },
    "helpTitle": {
      "type": "string",
      "maxLength": 60
    },
    "helpText": {
      "type": "text",
      "maxLength": 300
    },
    "homeTitleTemplate": {
      "type": "string",
      "maxLength": 80
    },
    "modTitleTemplate": {
      "type": "string",
      "maxLength": 80
    },
    "gameTitleTemplate": {
      "type": "string",
      "maxLength": 80
    },
    "blogTitleTemplate": {
      "type": "string",
      "maxLength": 80
    },
    "blogIndex": {
      "type": "component",
      "repeatable": false,
      "component": "pages.listing"
    },
    "modsIndex": {
      "type": "component",
      "repeatable": false,
      "component": "pages.listing"
    },
    "gamesIndex": {
      "type": "component",
      "repeatable": false,
      "component": "pages.listing"
    },
    "roadmapIndex": {
      "type": "component",
      "repeatable": false,
      "component": "pages.listing"
    },
    "notFound": {
      "type": "component",
      "repeatable": false,
      "component": "pages.listing"
    },
    "spoilerNotice": {
      "type": "component",
      "repeatable": false,
      "component": "pages.spoiler-notice"
    }
  }
}
