{
  "kind": "singleType",
  "collectionName": "site_settings_list",
  "info": {
    "singularName": "site-settings",
    "pluralName": "site-settings-list",
    "displayName": "Site settings"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true,
      "default": "Rioku Labs"
    },
    "shortName": {
      "type": "string",
      "default": "Rioku Labs"
    },
    "description": {
      "type": "text"
    },
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "logo": {
      "type": "component",
      "repeatable": false,
      "component": "media.image"
    },
    "logoMark": {
      "type": "component",
      "repeatable": false,
      "component": "media.image"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link"
    },
    "notAffiliatedText": {
      "type": "text"
    },
    "analyticsEnabled": {
      "type": "boolean",
      "default": false
    }
  }
}
