{
  "collectionName": "components_media_images",
  "info": {
    "displayName": "Image",
    "icon": "picture",
    "description": "An uploaded image with alt text, caption, credit and focal point."
  },
  "options": {},
  "attributes": {
    "file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "required": true
    },
    "alt": {
      "type": "string",
      "required": true,
      "maxLength": 250
    },
    "decorative": {
      "type": "boolean",
      "default": false
    },
    "caption": {
      "type": "text"
    },
    "credit": {
      "type": "string"
    },
    "focalX": {
      "type": "decimal",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    "focalY": {
      "type": "decimal",
      "default": 0.5,
      "min": 0,
      "max": 1
    }
  }
}
