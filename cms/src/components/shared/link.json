{
  "collectionName": "components_shared_links",
  "info": {
    "displayName": "Link",
    "icon": "link",
    "description": "A link with a label. Kind picks the icon and, for profile links, whether it counts as one of the studio's own profiles."
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "internal",
        "external",
        "steam",
        "modio",
        "github",
        "rss",
        "youtube",
        "discord"
      ],
      "default": "internal"
    },
    "newTab": {
      "type": "boolean",
      "default": false
    }
  }
}
