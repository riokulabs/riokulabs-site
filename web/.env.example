# Copy to .env and fill in. Never commit .env.
# Data source: "fixtures" (default; offline, used by CI) or "strapi" (reads the CMS).
SITE_DATA=fixtures
STRAPI_URL=http://127.0.0.1:1337
# Custom read-only token named "site-build" (find/findOne on public types, plus find on Privacy-lists: a Strapi build
# checks its output against those lists). Created by `npm run tokens` in cms/.
STRAPI_BUILD_TOKEN=
# Canonical origin for links, sitemap and OG tags. Empty = https://<domain> from src/config/identity.json.
SITE_URL=
# static (default) | preview (M9; SSR preview Worker)
SITE_MODE=static
# Cloudflare Web Analytics beacon token, production only (M9).
CF_WEB_ANALYTICS_TOKEN=
SITE_NOINDEX=

# Draft-preview Worker only (npm run build:preview / preview:drafts). Locally, put these in web/.dev.vars (gitignored)
# or pass them to `wrangler dev --var`. Never commit real values.
STRAPI_PREVIEW_TOKEN=
PREVIEW_SECRET=
STRAPI_ADMIN_ORIGIN=http://127.0.0.1:1337
