{
  "name": "riokulabs-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "fetch-content": "tsx scripts/fetch-content.ts && tsx scripts/vendor.ts && tsx scripts/brand.ts",
    "predev": "npm run fetch-content && npm run fetch-models",
    "dev": "astro dev",
    "prebuild": "npm run fetch-content && npm run fetch-models",
    "build": "astro build",
    "postbuild": "npm run pages:compat && npm run lint:dist && npm run check:feeds",
    "build:strapi": "SITE_DATA=strapi npm run build",
    "preview": "tsx scripts/serve.ts 4321",
    "check": "astro check",
    "test": "vitest run",
    "lint:dist": "tsx scripts/lint-dist.ts",
    "pages:compat": "tsx scripts/pages-compat.ts",
    "test:e2e": "playwright test",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "astro": "astro",
    "serve": "tsx scripts/serve.ts",
    "check:feeds": "tsx scripts/validate-feeds.ts",
    "screens": "tsx scripts/screens.ts",
    "build:preview": "SITE_MODE=preview npm run fetch-content && SITE_MODE=preview astro build && tsx scripts/preview-strip.ts",
    "preview:drafts": "wrangler dev --config dist-preview/server/wrangler.json --port 8788",
    "fetch-models": "tsx scripts/fetch-models.ts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@google/model-viewer": "^4.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.1",
    "meshoptimizer": "^1.3.0",
    "qs": "^6.16.1",
    "satori": "^0.63.0",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/cloudflare": "^14.4.1",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/qs": "^6.15.1",
    "@types/three": "^0.186.0",
    "fast-xml-parser": "^5.11.2",
    "lighthouse": "^13.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
