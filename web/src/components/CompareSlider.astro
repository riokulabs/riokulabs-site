---
/**
 * Before/after compare (SPEC §4.5, §4.6). The "after" image is revealed by a native range input (keyboard: arrows,
 * Home/End, PageUp/Down), so it is operable and announced without custom ARIA. Without JS both images stack.
 */
import Picture from './Picture.astro';
import type { Img } from '../lib/types';
interface Props { before: Img; after: Img; beforeLabel?: string; afterLabel?: string; caption?: string; sizes?: string }
const { before, after, beforeLabel = 'Before', afterLabel = 'After', caption, sizes = '(min-width: 1240px) 1100px, 100vw' } = Astro.props;
const id = `cmp-${Math.random().toString(36).slice(2, 8)}`;
---
<figure class="frame compare" data-compare style="--pos: 50%">
  <div class="frame__media compare__stage" style={`aspect-ratio: ${after.width} / ${after.height}`}>
    <div class="compare__img compare__before"><Picture image={before} sizes={sizes} /></div>
    <div class="compare__img compare__after"><Picture image={after} sizes={sizes} /></div>
    <span class="compare__tag compare__tag--l label" aria-hidden="true">{beforeLabel}</span>
    <span class="compare__tag compare__tag--r label" aria-hidden="true">{afterLabel}</span>
    <div class="compare__handle" aria-hidden="true"><span></span></div>
    <label class="visually-hidden" for={id}>Reveal {afterLabel} over {beforeLabel} (percent)</label>
    <input id={id} class="compare__range" type="range" min="0" max="100" value="50" step="1" aria-valuetext={`${afterLabel} 50%`} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-compare]')) {
    const input = fig.querySelector<HTMLInputElement>('input[type=range]')!;
    const after = fig.querySelector('.compare__tag--r')?.textContent ?? 'After';
    const set = () => {
      fig.style.setProperty('--pos', `${input.value}%`);
      input.setAttribute('aria-valuetext', `${after} ${100 - Number(input.value)}%`);
    };
    input.addEventListener('input', set);
    set();
  }
</script>
<style>
  .compare { margin: var(--space-6) 0; }
  .compare__stage { position: relative; touch-action: pan-y; }
  .compare__img { position: absolute; inset: 0; }
  .compare__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .compare__after { clip-path: inset(0 0 0 var(--pos)); }
  .compare__handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: var(--burn-core); box-shadow: 0 0 14px var(--burn); pointer-events: none; z-index: 2; }
  .compare__handle span { position: absolute; top: 50%; left: 50%; width: 36px; height: 36px; margin: -18px 0 0 -18px; border-radius: 50%; border: 2px solid var(--burn-core); background: rgb(5 7 11 / 0.7); }
  .compare__handle span::before, .compare__handle span::after { content: ''; position: absolute; top: 50%; width: 0; height: 0; margin-top: -5px; border: 5px solid transparent; }
  .compare__handle span::before { left: 3px; border-right-color: var(--burn-core); }
  .compare__handle span::after { right: 3px; border-left-color: var(--burn-core); }
  .compare__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; z-index: 3; }
  .compare__range:focus-visible + * , .compare:has(.compare__range:focus-visible) .compare__handle span { outline: 2px solid var(--burn); outline-offset: 3px; }
  .compare__tag { position: absolute; top: var(--space-3); z-index: 2; padding: 0.35em 0.6em; background: rgb(5 7 11 / 0.8); border: 1px solid var(--line-strong); }
  .compare__tag--l { left: var(--space-3); }
  .compare__tag--r { right: var(--space-3); color: var(--burn); }
  html:not(.js) .compare__stage { aspect-ratio: auto !important; }
  html:not(.js) .compare__img { position: static; }
  html:not(.js) .compare__after { clip-path: none; }
  html:not(.js) .compare__handle, html:not(.js) .compare__range { display: none; }
</style>
