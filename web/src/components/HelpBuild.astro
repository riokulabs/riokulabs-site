---
/** "Help build mods": the open invitation to contribute (home, roadmap, about, mods). No forms, no promises.
 *  Wording: the page's own (its listing fields), else Site settings > Help-build heading and text. */
import { GITHUB_ORG } from '../config/brand';
import { site } from '../lib/site';
interface Props { id?: string; title?: string; text?: string }
const copy = site().copy;
const { id = 'help-title' } = Astro.props;
const title = Astro.props.title || copy.helpTitle;
const text = Astro.props.text || copy.helpText;
const org = `https://github.com/${GITHUB_ORG}`;
---
<section class="section join" aria-labelledby={id}>
  <div class="wrap wrap--narrow reveal">
    <h2 id={id}>{title}</h2>
    <p class="lead">{text}</p>
    <p class="terminal" aria-hidden="true"><b>&gt;</b> no application form. just say hi.</p>
    <div class="btn-row">
      <a class="btn" href={org} rel="noopener">{GITHUB_ORG} on GitHub</a>
      <a class="btn btn--ghost" href={`${org}/.github/blob/main/CONTRIBUTING.md`} rel="noopener">How to contribute</a>
    </div>
  </div>
</section>
