---
/**
 * Mod tile (home "Our mods", the Mods browser). Mods with a page get their card image (or hero loop when `video`);
 * ideas, teasers and mods without a picture get a blueprint plate with the flask mark: a name and one vague line, nothing more.
 */
import Picture from './Picture.astro';
import type { Mod } from '../lib/types';
import { getGame, modUrl } from '../lib/site';
import { modBucket, modState } from '../lib/status';
interface Teaser { title: string; text: string; status: string; href?: string }
interface Props { mod?: Mod; teaser?: Teaser; big?: boolean; video?: boolean; blocks?: number }
const { mod, teaser, big = false, video = false, blocks } = Astro.props;
const live = mod && mod.status !== 'idea';
const image = mod && (mod.card ?? (mod.hero?.kind === 'image' ? mod.hero.image : mod.hero?.video.poster));
const loop = video && mod?.hero?.kind === 'video' ? mod.hero.video : undefined;
const st = mod ? modState(mod) : { label: teaser!.status, detail: undefined, tone: 'mute' as const };
const game = mod ? getGame(mod.game)?.name : undefined;
const meta = [game, blocks ? `${blocks} blocks` : undefined, mod?.license].filter(Boolean).join(' · ');
const Tag = live ? 'a' : teaser?.href ? 'a' : 'div';
const href = live ? modUrl(mod!) : teaser?.href;
---
<Tag class:list={['tile', live ? 'tile--live' : 'tile--tease', big && 'tile--big']} href={href} data-status={mod ? modBucket(mod) : 'works'} data-game={mod?.game}>
  <span class="tile__shot">
    {live && loop ? (
      <Fragment><Picture image={loop.poster} alt="" sizes={big ? '(min-width: 1000px) 600px, 100vw' : '(min-width: 1000px) 300px, 100vw'} />
      <video data-loop muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"><source src={loop.mp4} type="video/mp4" /></video></Fragment>
    ) : live && image ? (
      <Picture image={image} alt="" sizes={big ? '(min-width: 1000px) 600px, 100vw' : '(min-width: 1000px) 300px, 100vw'} />
    ) : (
      <span class="tile__plate" aria-hidden="true">
        <svg viewBox="0 0 16 16"><path fill-rule="evenodd" d="M12 3 L12 1 L4 1 L4 3 L5 3 L5 7 L1 13 L1 15 L15 15 L15 13 L11 7 L11 3ZM9 3 L9 7.8 L12.6 13 L3.4 13 L7 7.8 L7 3Z" /></svg>
        <span class="tile__stamp">Not shown yet</span>
      </span>
    )}
  </span>
  <span class="tile__body">
    <span class:list={['status', st.tone !== 'amber' && `status--${st.tone}`]}><span>{st.label}</span>{st.detail && <span><span class="visually-hidden">, </span>{st.detail}</span>}</span>
    <h3>{mod?.name ?? teaser!.title}</h3>
    <p>{mod?.tagline ?? teaser!.text}</p>
    {live && meta && <span class="tile__meta">{meta}</span>}
  </span>
</Tag>
<style>
  .tile { display: flex; flex-direction: column; min-width: 0; border: 1px solid var(--line); background: rgb(10 14 19 / 0.6); color: inherit; text-decoration: none; }
  .tile__shot { display: block; width: 100%; flex: none; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--line); position: relative; background: #070a0e; }
  .tile__shot :global(img), .tile__shot video { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease), opacity 400ms; }
  .tile__shot video { position: absolute; inset: 0; opacity: 0; }
  .tile__shot video:global(.is-playing) { opacity: 1; }
  .tile--live { transition: border-color 200ms; }
  .tile--live:hover { border-color: var(--burn); }
  .tile--live:hover .tile__shot :global(img), .tile--live:hover .tile__shot video { transform: scale(1.03); }
  .tile__body { display: flex; flex-direction: column; gap: 12px; padding: 24px 26px 28px; flex: 1; }
  .tile h3 { font-size: 34px; line-height: 1; margin: 0; }
  .tile p { color: var(--text-muted); font-size: 16px; margin: 0; }
  .tile__meta { font: 400 12px/1 var(--font-mono); color: var(--text-faint); letter-spacing: 0.04em; margin-top: auto; }
  .tile--tease h3 { color: var(--text-muted); }
  a.tile--tease:hover { border-color: var(--line-strong); }
  /* no picture yet: a still blueprint sheet with the studio's flask stamped on it, plainly on purpose (no bars, no shimmer) */
  .tile__plate { position: absolute; inset: 0; display: grid; place-items: center; color: rgb(120 190 255 / 0.16);
    background: linear-gradient(var(--line-faint) 1px, transparent 1px) 0 0 / 100% 24px, linear-gradient(90deg, var(--line-faint) 1px, transparent 1px) 0 0 / 24px 100%, radial-gradient(60% 70% at 50% 50%, #0b1119, #06090d); }
  /* centre lines, like a drawing sheet */
  .tile__plate::before, .tile__plate::after { content: ''; position: absolute; background: repeating-linear-gradient(90deg, var(--line) 0 10px, transparent 10px 16px); }
  .tile__plate::before { left: 6%; right: 6%; top: 50%; height: 1px; }
  .tile__plate::after { top: 8%; bottom: 8%; left: 50%; width: 1px; background: repeating-linear-gradient(180deg, var(--line) 0 10px, transparent 10px 16px); }
  .tile__plate svg { position: relative; z-index: 1; width: 30%; max-width: 120px; height: auto; fill: currentColor; }
  .tile__stamp { position: absolute; z-index: 1; right: 14px; bottom: 12px; padding: 5px 8px; border: 1px dashed var(--line-strong); font: 500 10.5px/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-faint); background: #070a0e; }
  .tile--big .tile__body { padding: 28px 30px 32px; }
</style>
