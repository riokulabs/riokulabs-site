---
/**
 * Dev-log card. Spoiler posts hide their cover under a blur and hazard tape and never show the excerpt; the reader
 * meets the warning on the post page first. data-* attributes feed the /blog filters.
 */
import Picture from './Picture.astro';
import type { Post } from '../lib/types';
import { fmtDate, getMod, site, tagName } from '../lib/site';
interface Props { post: Post; lead?: boolean; headingLevel?: 'h2' | 'h3' }
const { post, lead = false, headingLevel: H = 'h3' } = Astro.props;
const mods = post.relatedMods.filter((m) => getMod(m)?.visibility === 'public');
---
<a class:list={['pcard', lead && 'pcard--lead', post.spoiler && 'pcard--spoil']} href={`/blog/${post.slug}`}
  data-mods={mods.join(' ')} data-tags={post.tags.join(' ')} data-spoiler={post.spoiler ? '1' : undefined} data-text={`${post.title} ${post.spoiler ? '' : post.excerpt}`.toLowerCase()}>
  <span class="pcard__cover">
    {post.cover ? <Picture image={post.cover} alt="" sizes={lead ? '(min-width: 1000px) 720px, 100vw' : '(min-width: 1240px) 384px, (min-width: 1000px) 31vw, (min-width: 640px) 50vw, 100vw'} /> : <span class="pcard__blank" aria-hidden="true"></span>}
    {post.spoiler && <span class="pcard__tape" aria-hidden="true">Spoiler</span>}
  </span>
  <span class="pcard__txt">
    <span class="pcard__meta"><time datetime={post.date}>{fmtDate(post.date)}</time><span>{post.readingMinutes} min read</span></span>
    <H class="pcard__title">{post.title}</H>
    <p>{post.spoiler ? site().copy.spoilerNotice.cardText : post.excerpt}</p>
    <span class="chips">
      {post.spoiler && <span class="chip chip--warn">spoiler</span>}
      {mods.map((m) => <span class="chip chip--mod">{m}</span>)}
      {post.tags.filter((t) => !mods.includes(t)).slice(0, 2).map((t) => <span class="chip">{tagName(t)}</span>)}
    </span>
  </span>
</a>
<style>
  .pcard { display: flex; flex-direction: column; border: 1px solid var(--line); background: var(--bg-hull); overflow: hidden; color: inherit; text-decoration: none; height: 100%; transition: border-color 250ms, transform 350ms var(--ease); }
  .pcard:hover { border-color: var(--burn); transform: translateY(-4px); }
  .pcard__cover { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: #070a0e; border-bottom: 1px solid var(--line); }
  .pcard__cover :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 800ms var(--ease), filter 400ms; }
  .pcard:hover .pcard__cover :global(img) { transform: scale(1.04); }
  /* a scan line runs down the cover on hover */
  .pcard__cover::after { content: ''; position: absolute; left: 0; right: 0; top: -10%; height: 2px; background: var(--burn); box-shadow: 0 0 14px 2px rgb(79 184 255 / 0.6); opacity: 0; }
  .pcard:hover .pcard__cover::after { animation: scan-y 1.1s var(--ease) forwards; }
  @keyframes scan-y { 0% { top: -5%; opacity: 0.9; } 100% { top: 105%; opacity: 0; } }
  .pcard__blank { position: absolute; inset: 0; background: linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 100% 24px, linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 24px 100%, url(/favicon.svg) center / 72px no-repeat; }
  .pcard__txt { display: flex; flex-direction: column; gap: 12px; padding: 22px 24px 26px; flex: 1; }
  .pcard__meta { display: flex; gap: 14px; font: 400 12px/1 var(--font-mono); color: var(--text-faint); }
  .pcard__title { font-size: 28px; line-height: 1; margin: 2px 0 0; }
  .pcard p { color: var(--text-muted); font-size: 16px; margin: 0; }
  .pcard .chips { margin-top: auto; padding-top: 6px; }
  .pcard--lead { display: grid; grid-template-columns: 1.35fr 1fr; }
  .pcard--lead .pcard__cover { aspect-ratio: auto; min-height: 360px; border-bottom: 0; border-right: 1px solid var(--line); }
  .pcard--lead .pcard__txt { padding: 40px 40px 36px; justify-content: center; }
  .pcard--lead .pcard__title { font-size: clamp(40px, 4vw, 60px); }
  .pcard--lead p { font-size: 18px; }
  .pcard--lead .pcard__txt::before { content: 'Latest'; font: 500 11px/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ember); }
  .pcard--spoil { border-color: rgb(255 179 71 / 0.35); }
  .pcard--spoil .pcard__cover :global(img) { filter: blur(14px) saturate(0.4) brightness(0.6); transform: scale(1.15); }
  .pcard--spoil:hover .pcard__cover :global(img) { transform: scale(1.15); }
  .pcard--spoil p { color: var(--text-faint); font-style: italic; }
  .pcard__tape { position: absolute; left: -10%; right: -10%; top: 50%; transform: translateY(-50%) rotate(-6deg); padding: 10px 0; text-align: center; font: 700 22px/1 var(--font-display); letter-spacing: 0.3em; text-transform: uppercase; color: #1a0f00; background: repeating-linear-gradient(-45deg, var(--ember) 0 18px, #ffc76e 18px 36px); box-shadow: 0 6px 30px rgb(0 0 0 / 0.6); }
  @media (max-width: 1000px) { .pcard--lead { grid-template-columns: 1fr; } .pcard--lead .pcard__cover { min-height: 0; aspect-ratio: 16 / 9; border-right: 0; border-bottom: 1px solid var(--line); } .pcard--lead .pcard__txt { padding: 24px; } }
  @media (prefers-reduced-motion: reduce) { .pcard:hover { transform: none; } .pcard:hover .pcard__cover::after { animation: none; } }
  :global(html[data-motion='reduced']) .pcard:hover { transform: none; }
</style>
