---
/**
 * YouTube player for the sections.youtube-embed body section: a 16:9 iframe on youtube-nocookie.com (YouTube's
 * privacy-enhanced mode), lazy-loaded. `id` is already checked by lib/youtube.ts (11 URL-safe characters).
 * Below it: the optional caption and a plain "Watch on YouTube" link.
 */
import { youtubeEmbedUrl, youtubeWatchUrl } from '../lib/youtube';
interface Props { id: string; title: string; caption?: string; class?: string }
const { id, title, caption, class: cls } = Astro.props;
---
<figure class:list={['frame yt', cls]} data-youtube>
  <div class="frame__media ratio-16x9">
    <iframe
      src={youtubeEmbedUrl(id)}
      title={title}
      width="1280"
      height="720"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
  <figcaption>
    {caption && <span class="yt__cap">{caption}</span>}
    <a class="yt__link" href={youtubeWatchUrl(id)} rel="noopener">Watch on YouTube<span class="visually-hidden">: {title}</span></a>
  </figcaption>
</figure>
<style>
  .yt iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .yt figcaption { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-4); max-width: none; }
  .yt__cap { flex: 1 1 32ch; max-width: var(--measure); }
  .yt__link { flex: none; font: 600 0.75rem/1 var(--font-display); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text); }
  .yt__link:hover { color: var(--burn-core); }
</style>
