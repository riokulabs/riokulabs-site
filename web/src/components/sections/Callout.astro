---
import { renderBlocks } from '../../lib/richtext';
import type { RichBlocks } from '../../lib/types';
interface Props { tone: 'note' | 'tip' | 'caution'; title?: string; body: RichBlocks }
const { tone, title, body } = Astro.props;
const label = { note: 'Note', tip: 'Tip', caution: 'Caution' }[tone];
---
<aside class:list={['callout plate', `callout--${tone}`, tone === 'caution' && 'hazard']} aria-label={title ?? label}>
  <p class="label callout__tone">
    <svg viewBox="0 0 20 20" aria-hidden="true" width="16" height="16">
      {tone === 'caution' ? <path d="M10 2 1 18h18L10 2zm-1 6h2v5H9V8zm0 6h2v2H9v-2z" fill="currentColor" /> : tone === 'tip' ? <path d="M10 2a6 6 0 0 0-3.5 10.9V15h7v-2.1A6 6 0 0 0 10 2zM7.5 16.5h5V18h-5z" fill="currentColor" /> : <path d="M10 1a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm1 14H9V9h2v6zm0-8H9V5h2v2z" fill="currentColor" />}
    </svg>
    {label}
  </p>
  {title && <p class="callout__title">{title}</p>}
  <div class="prose" set:html={renderBlocks(body)} />
</aside>
<style>
  .callout { margin: var(--space-6) 0; padding: var(--space-5) var(--space-5) var(--space-3); }
  .callout--caution { padding-top: calc(var(--space-5) + 6px); }
  .callout__tone { display: flex; align-items: center; gap: 0.5em; margin: 0 0 var(--space-2); }
  .callout--note .callout__tone { color: var(--burn); }
  .callout--tip .callout__tone { color: var(--status-live); }
  .callout--caution .callout__tone { color: var(--trim); }
  .callout__title { font: 700 1.3rem/1.2 var(--font-display); margin: 0 0 var(--space-2); color: #fff; }
</style>
