---
interface Props { text: string; attribution?: string }
const { text, attribution } = Astro.props;
---
<figure class="pull">
  <blockquote><p>{text}</p></blockquote>
  {attribution && <figcaption class="label">{attribution}</figcaption>}
</figure>
<style>
  .pull { margin: var(--space-7) 0; padding: var(--space-5) 0 var(--space-5) var(--space-5); border-left: 3px solid var(--burn); position: relative; }
  .pull::before { content: ''; position: absolute; left: -3px; top: 0; width: 3px; height: 40%; background: var(--burn-core); box-shadow: 0 0 16px var(--burn); }
  .pull blockquote { margin: 0; }
  .pull p { font: 600 clamp(1.5rem, 1.2rem + 1.3vw, 2.25rem)/1.15 var(--font-display); color: #fff; margin: 0; text-wrap: balance; }
  .pull figcaption { margin-top: var(--space-3); }
</style>
