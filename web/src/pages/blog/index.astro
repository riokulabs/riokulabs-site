---
import { STUDIO_NAME } from '../../config/brand';
import Base from '../../layouts/Base.astro';
import BlogList from '../../components/BlogList.astro';
import { absolute, listedPosts, primaryGame, site } from '../../lib/site';
import { blogTitle, collectionJsonLd } from '../../lib/seo';
import { inlineHtml, plainText } from '../../lib/copy';
const { copy } = site();
const page = copy.blogIndex;
const posts = listedPosts();
const description = plainText(page.metaDescription);
const jsonLd = collectionJsonLd({ name: page.title, description, url: absolute('/blog') }, posts.map((p) => ({ name: p.title, url: absolute(`/blog/${p.slug}`) })));
const title = page.metaTitle || blogTitle(primaryGame()?.name, STUDIO_NAME, copy.blogTitleTemplate, page.title);
---
<Base title={title} path="/blog" ogPath="/og/blog.png" description={description} jsonLd={jsonLd}>
  <div class="wrap page-head">
    <h1>{page.title}</h1>
    <p class="lead" set:html={inlineHtml(page.intro)} />
  </div>
  <div class="wrap"><BlogList posts={posts} emptyText={page.emptyText} /></div>
</Base>
