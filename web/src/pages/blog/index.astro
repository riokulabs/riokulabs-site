---
import { STUDIO_NAME } from '../../config/brand';
import Base from '../../layouts/Base.astro';
import BlogList from '../../components/BlogList.astro';
import { listedPosts } from '../../lib/site';
const posts = listedPosts();
---
<Base title="Dev log" path="/blog" ogPath="/og/blog.png" description={`The ${STUDIO_NAME} dev log: what we built, what broke, and what's next.`}>
  <div class="wrap page-head">
    <h1>Dev log</h1>
    <p class="lead">What we built, what broke, and what's next. Filter by mod or topic, or follow the <a href="/rss.xml">RSS feed</a>.</p>
  </div>
  <div class="wrap"><BlogList posts={posts} /></div>
</Base>
