---
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';
import { absolute, gameUrl, listedGames, modsForGame, site } from '../../lib/site';
import { inlineHtml, plainText } from '../../lib/copy';
import { bucketCounts } from '../../lib/status';
import { collectionJsonLd } from '../../lib/seo';
const games = listedGames();
const page = site().copy.gamesIndex;
const description = plainText(page.metaDescription);
const jsonLd = collectionJsonLd({ name: page.title, description, url: absolute('/games') }, games.map((g) => ({ name: g.name, url: absolute(gameUrl(g.slug)) })));
---
<Base title={page.metaTitle || page.title} path="/games" ogPath="/og/games.png" description={description} jsonLd={jsonLd}>
  <div class="wrap page-head">
    <p class="label eyebrow type-on"><span>Index</span></p>
    <h1>{page.title}</h1>
    <p class="lead" set:html={inlineHtml(page.intro)} />
  </div>
  <div class="wrap">
    {games.length ? (
      <ul class="game-list plain-list">
        {games.map((g) => {
          const mods = modsForGame(g.slug);
          return (
            <li class="reveal">
              <a class="game-row plate" href={`/games/${g.slug}`} data-game={g.slug}>
                {g.art && <span class="game-row__art"><Picture image={g.art} sizes="(min-width: 960px) 520px, 100vw" widths={[480, 768, 1200]} alt="" /></span>}
                <span class="game-row__body">
                  <span class="label label--burn">{g.shortName}</span>
                  <h2 class="game-row__name">{g.name}</h2>
                  <span class="game-row__tag">{g.tagline}</span>
                  <span class="game-row__counts">
                    {bucketCounts(mods).map((b) => (
                      <span class="chip"><span class={`lamp lamp--${b.lamp}`} aria-hidden="true"></span>{b.count} {b.label.toLowerCase()}</span>
                    ))}
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="empty plate plate--pad" set:html={inlineHtml(page.emptyText)} />
    )}
  </div>
</Base>
<style>
  .plain-list { list-style: none; margin: 0; padding: 0; }
  .game-list { display: grid; gap: var(--space-5); }
  .game-row { display: grid; overflow: hidden; text-decoration: none; color: var(--text); }
  @media (min-width: 900px) { .game-row { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } }
  .game-row__art { position: relative; min-height: 220px; aspect-ratio: 16 / 9; background: var(--bg-hull-2); overflow: hidden; }
  .game-row__art :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .game-row__body { display: grid; gap: var(--space-3); padding: clamp(24px, 4vw, 48px); align-content: center; justify-items: start; }
  .game-row__name { margin: 0; font-size: clamp(2rem, 1.5rem + 2vw, 3.25rem); text-transform: uppercase; }
  .game-row__tag { color: var(--text-muted); max-width: 52ch; }
  .game-row__counts { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .game-row__counts .chip { display: inline-flex; align-items: center; gap: 0.5em; }
  a.game-row:hover .game-row__name { color: var(--burn-core); }
  .empty { color: var(--text-muted); max-width: 60ch; }
</style>
