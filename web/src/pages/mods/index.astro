---
/** The mod browser: every listed mod and teaser, filterable by status and game. Sparse today; fills up as mods arrive. */
import Base from '../../layouts/Base.astro';
import ModTile from '../../components/ModTile.astro';
import HelpBuild from '../../components/HelpBuild.astro';
import { absolute, getGame, listedMods, modUrl, site } from '../../lib/site';
import { inlineHtml, plainText } from '../../lib/copy';
import { collectionJsonLd } from '../../lib/seo';
import { catalog } from '../../lib/models';
import { bucketCounts } from '../../lib/status';

const mods = listedMods();
// Same stage-aware buckets as the tile badges (lib/status.ts); a filter with nothing in it isn't offered.
const buckets = bucketCounts(mods);
const STATES = [{ key: 'all', label: 'All', count: mods.length }, ...buckets];
const games = [...new Set(mods.map((m) => m.game).filter(Boolean))].map((g) => ({ slug: g, name: getGame(g)?.name ?? g }));
const page = site().copy.modsIndex;
const description = plainText(page.metaDescription);
// Only mods with a page of their own are listed (ideas are teaser tiles with no address).
const jsonLd = collectionJsonLd({ name: page.title, description, url: absolute('/mods') }, mods.filter((m) => m.status !== 'idea').map((m) => ({ name: m.name, url: absolute(modUrl(m)) })));
---
<Base title={page.metaTitle || page.title} path="/mods" ogPath="/og/mods.png" description={description} jsonLd={jsonLd}>
  <div class="wrap page-head">
    <h1>{page.title}</h1>
    <p class="lead" set:html={inlineHtml(page.intro)} />
  </div>
  <div class="wrap">
    <div class="filters" data-filters>
      <div class="seg-row" role="group" aria-label="Status">
        {STATES.map((s, i) => <button type="button" data-f={s.key} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label} <small>{s.count}</small></button>)}
      </div>
      {games.length > 0 && (
        <div class="seg-row" role="group" aria-label="Game">
          <button type="button" data-g="all" aria-pressed="true">All games</button>
          {games.map((g) => <button type="button" data-g={g.slug} aria-pressed="false">{g.name}</button>)}
        </div>
      )}
    </div>
    <p class="visually-hidden" aria-live="polite" data-filter-status></p>
    <h2 class="visually-hidden">All mods</h2>
    <div class="browse" data-grid>
      {mods.map((m) => <ModTile mod={m} blocks={catalog(m.slug).length || undefined} />)}
    </div>
    <p class="empty" data-empty hidden={mods.length > 0 || undefined} set:html={inlineHtml(page.emptyText)} />
  </div>
  <HelpBuild title={page.helpTitle} text={page.helpText} />
</Base>
<script>
  const root = document.querySelector('[data-filters]');
  const tiles = [...document.querySelectorAll<HTMLElement>('[data-grid] > .tile')];
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const say = document.querySelector<HTMLElement>('[data-filter-status]');
  let f = 'all', g = 'all';
  const apply = () => {
    let n = 0;
    for (const t of tiles) { const ok = (f === 'all' || t.dataset.status === f) && (g === 'all' || t.dataset.game === g); t.hidden = !ok; n += Number(ok); }
    if (empty) empty.hidden = n > 0;
    if (say) say.textContent = `${n} mod${n === 1 ? '' : 's'} shown`;
  };
  root?.addEventListener('click', (e) => {
    const b = (e.target as Element).closest('button'); if (!b) return;
    b.parentElement!.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    if (b.dataset.f) f = b.dataset.f; if (b.dataset.g) g = b.dataset.g;
    apply();
  });
</script>
<style>
  .filters { display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center; }
  .browse { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; }
  .browse > :global([hidden]) { display: none; }
  .empty { margin-top: 40px; color: var(--text-muted); }
  @media (max-width: 1000px) { .browse { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .browse { grid-template-columns: 1fr; } }
</style>
