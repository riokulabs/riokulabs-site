// The draft-preview Worker (ARCHITECTURE §6), built with `npm run build:preview` (SITE_MODE=preview). The Astro
// Cloudflare adapter writes the final config to dist-preview/server/wrangler.json from this file. Setup: PREVIEW.md.
// Secrets (STRAPI_PREVIEW_TOKEN, PREVIEW_SECRET) are set on the Worker with `wrangler secret put` or in the dashboard,
// never here. Local test: put them in web/.dev.vars (gitignored) and run `npm run preview:drafts`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riokulabs-preview",
  "compatibility_date": "2026-10-01",
  // AsyncLocalStorage (per-request draft data) and node:path in shared modules
  "compatibility_flags": ["nodejs_compat"],
  // Served only on preview.<domain from src/config/identity.json> (a Worker custom domain: Cloudflare creates the DNS
  // record and certificate; the zone is found by name, so no account or zone IDs live here). No *.workers.dev URL and no
  // per-version preview URLs, so Cloudflare Access on the custom domain covers every way in.
  "routes": [{ "pattern": "preview.rioku.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SITE_MODE": "preview"
  },
  // STRAPI_URL and STRAPI_ADMIN_ORIGIN are set on the Worker (dashboard → Settings → Variables); keep them on deploy
  // instead of replacing them with only the vars above.
  "keep_vars": true
}
